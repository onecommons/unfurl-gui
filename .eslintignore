node_modules/
dist/

# src/gitlab-oc is a symlink to packages/oc-pages. Linting through it would
# double-report every file, and its nested node_modules holds
# eslint-loader@2.2.1, whose package.json eslintConfig extends a config that
# isn't installed -- eslint fails on that while resolving, before any file is
# linted. Lint packages/oc-pages directly instead.
src/gitlab-oc/


# Verbatim copies of the fork's @vue/compat shims (see the header in each).
# They lint against gitlab's own plugin set, not ours -- our config has no
# @gitlab/require-i18n-strings, and eslint errors on the disable comment for a
# rule it cannot find. Editing them to suit would defeat the point of copying.
src/assets/javascripts/vue3compat/
