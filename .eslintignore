node_modules/
dist/

# src/gitlab-oc is a symlink to packages/oc-pages. Linting through it would
# double-report every file, and its nested node_modules holds
# eslint-loader@2.2.1, whose package.json eslintConfig extends a config that
# isn't installed -- eslint fails on that while resolving, before any file is
# linted. Lint packages/oc-pages directly instead.
src/gitlab-oc/

