{
  "_comment": "Trimmed stand-in for the unfurl-server /types response the cloud map is built from. Field shapes match production: package ids are host/namespace/project, implementation_requirements hold the canonical ConnectsTo.* values that ProviderIcons and lookupCloudProviderAlias are keyed by, and _sourceinfo.url is present on every type because the chart dereferences it unguarded. Also usable as dev data: serve this file as 'types' on the port vue.config.js proxies /services/unfurl-server to.",

  "Overview": {
    "documentation_url_template": "https://{host}/{namespace}/{project}/-/blob/main/{module}.yaml",
